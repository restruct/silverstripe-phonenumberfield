<?xml version="1.0" encoding="UTF-8"?>
<!-- For running from a host project that requires this module through a symlinked path
     repository (see README "Running the tests"). failOnWarning is pinned because whether a PHP
     warning fails a test is the runner's behaviour and differs between PHPUnit majors. -->
<phpunit bootstrap="vendor/silverstripe/framework/tests/bootstrap.php" colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="phonenumberfield">
            <directory>vendor/restruct/silverstripe-phonenumberfield/tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
